# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---------- Node ----------
node_modules/

# ---------- 构建产物 ----------
frontend/dist/
backend/dist/
backend/build/
release/
*.exe

# ---------- 嵌入模型 ----------
# bge-small-zh 的 ONNX 模型约 91 MB，不进版本库。
# 首次运行会自动从镜像下载；离线分发由打包流程打进安装包，
# 因此终端用户不受影响，只有源码运行者需要联网一次。
backend/models/

# ---------- 本地模型随包暂存 ----------
# llama-server.exe 已被上面的 *.exe 覆盖；模型 gguf 体积巨大，严禁入库（只留 README 说明）。
llama-pkg/*.gguf
llama-pkg/models/

# ---------- 运行时数据 ----------
# 含用户导入的知识库（rag.db）与明文存储的云端 API Key（settings.json），严禁入库。
# 逐个文件名兜底：不论数据目录被指到哪，这两个文件都不会被误提交
backend/data/
rag.db
rag.db-shm
rag.db-wal
settings.json

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
Thumbs.db
Desktop.ini
